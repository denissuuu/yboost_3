generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  recipes   Recipe[]
  ratings   Rating[]
  favorites Favorite[]
}

model Recipe {
  id             String     @id @default(cuid())
  title          String
  description    String
  country        String
  type           String
  diet           String[]
  ingredients    Json
  ingredientText String     @default("")
  steps          String[]
  imageUrl       String?
  authorId       String
  author         User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  ratings        Rating[]
  favorites      Favorite[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Rating {
  id       String @id @default(cuid())
  score    Int
  userId   String
  recipeId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
}

model Favorite {
  userId   String
  recipeId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([userId, recipeId])
}

